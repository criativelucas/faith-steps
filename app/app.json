{
  "expo": {
    "name": "Faith Steps",
    "slug": "faith-steps",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#42124C",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A0A31",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Faith Steps",
      "shortName": "Faith Steps",
      "themeColor": "#42124C",
      "backgroundColor": "#42124C",
      "description": "Seu personagem cresce a cada passo de fé que você dá na vida real."
    },
    "experiments": {
      "baseUrl": "/faith-steps"
    },
    "plugins": [
      "expo-font"
    ]
  }
}

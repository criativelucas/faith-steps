# Copie para app/.env e preencha com os dados do seu projeto Supabase
# (Project Settings > API Keys). A chave publishable é pública por natureza:
# quem protege os dados é o Row Level Security de supabase/schema.sql.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
